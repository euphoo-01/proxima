<UserControl
    x:Class="Proxima.App.Shell.TopbarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Proxima.App.Shell"
    x:DataType="shell:TopbarViewModel">
    <Border Classes="proxima-topbar-root">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
                <TextBlock Classes="proxima-breadcrumb" Text="{Binding Breadcrumb}" />
                <TextBlock Classes="proxima-card-title" Text="{Binding CurrentSection}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="proxima-secondary proxima-toolbar" Content="Уведомления" />
                <Button Classes="proxima-primary proxima-toolbar" Content="Добавить" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
