<UserControl
    x:Class="Proxima.App.Shell.SidebarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Proxima.App.Shell"
    x:DataType="shell:SidebarViewModel">
    <Border Classes="proxima-sidebar-root">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Classes="proxima-page-title" Text="Proxima" />

            <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="8">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="shell:SidebarItemViewModel">
                            <Button
                                Classes="proxima-sidebar-item"
                                Classes.proxima-active="{Binding IsActive}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=shell:SidebarView}}"
                                CommandParameter="{Binding .}"
                                Content="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Grid.Row="2" Classes="proxima-caption" Text="Runtime AppShell" />
        </Grid>
    </Border>
</UserControl>
