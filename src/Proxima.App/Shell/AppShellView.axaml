<UserControl
    x:Class="Proxima.App.Shell.AppShellView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Proxima.App.Shell"
    xmlns:assets="using:Proxima.App.Views.Assets"
    xmlns:assetsViews="using:Proxima.App.Views.Assets"
    xmlns:assetDetails="using:Proxima.App.Views.AssetDetails"
    xmlns:assetDetailsViews="using:Proxima.App.Views.AssetDetails"
    xmlns:dashboard="using:Proxima.App.Views.Dashboard"
    xmlns:dashboardViews="using:Proxima.App.Views.Dashboard"
    xmlns:goals="using:Proxima.App.Views.Goals"
    xmlns:goalsViews="using:Proxima.App.Views.Goals"
    xmlns:import="using:Proxima.App.Views.Import"
    xmlns:importViews="using:Proxima.App.Views.Import"
    xmlns:notifications="using:Proxima.App.Views.Notifications"
    xmlns:notificationsViews="using:Proxima.App.Views.Notifications"
    xmlns:placeholder="using:Proxima.App.ViewModels.Placeholder"
    xmlns:placeholderViews="using:Proxima.App.Views.Placeholder"
    xmlns:profile="using:Proxima.App.Views.Profile"
    xmlns:profileViews="using:Proxima.App.Views.Profile"
    xmlns:settings="using:Proxima.App.Views.Settings"
    xmlns:settingsViews="using:Proxima.App.Views.Settings"
    xmlns:support="using:Proxima.App.Views.Support"
    xmlns:supportViews="using:Proxima.App.Views.Support"
    xmlns:taxes="using:Proxima.App.Views.Taxes"
    xmlns:taxesViews="using:Proxima.App.Views.Taxes"
    xmlns:vm="using:Proxima.App.ViewModels"
    x:DataType="shell:AppShellViewModel">

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="dashboard:DashboardViewModel"><dashboardViews:DashboardView /></DataTemplate>
        <DataTemplate x:DataType="assets:AssetsViewModel"><assetsViews:AssetsView /></DataTemplate>
        <DataTemplate x:DataType="import:ImportDialogViewModel"><importViews:ImportDialogView /></DataTemplate>
        <DataTemplate x:DataType="assetDetails:AssetDetailsViewModel"><assetDetailsViews:AssetDetailsView /></DataTemplate>
        <DataTemplate x:DataType="import:ManualImportViewModel"><importViews:ManualImportView /></DataTemplate>
        <DataTemplate x:DataType="goals:GoalsViewModel"><goalsViews:GoalsView /></DataTemplate>
        <DataTemplate x:DataType="taxes:TaxesViewModel"><taxesViews:TaxesView /></DataTemplate>
        <DataTemplate x:DataType="settings:SettingsViewModel"><settingsViews:SettingsView /></DataTemplate>
        <DataTemplate x:DataType="notifications:NotificationsViewModel"><notificationsViews:NotificationsView /></DataTemplate>
        <DataTemplate x:DataType="support:SupportViewModel"><supportViews:SupportView /></DataTemplate>
        <DataTemplate x:DataType="profile:ProfileViewModel"><profileViews:ProfileView /></DataTemplate>
        <DataTemplate x:DataType="placeholder:PlaceholderViewModel"><placeholderViews:PlaceholderView /></DataTemplate>
    </UserControl.DataTemplates>

    <Grid Background="{StaticResource ProximaBrush.Sidebar}">
        <Grid ColumnDefinitions="260,*">
            <shell:SidebarView DataContext="{Binding Sidebar}" />
            <Grid Grid.Column="1" RowDefinitions="80,*">
                <shell:TopbarView DataContext="{Binding Topbar}" />
                <ContentControl Grid.Row="1" Content="{Binding CurrentContent}" />
            </Grid>
        </Grid>

        <ItemsControl
            Margin="0,96,32,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            ItemsSource="{Binding Notifications.Toasts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AppNotificationViewModel">
                    <Border
                        Width="360"
                        Padding="16"
                        Background="#FBFCFF"
                        BorderBrush="#DDE7F3"
                        BorderThickness="1"
                        BoxShadow="0 18 46 0 #1A001629"
                        CornerRadius="{StaticResource ProximaRadius.Large}">
                        <Grid ColumnDefinitions="44,*" RowDefinitions="Auto,Auto,Auto">
                            <Border
                                Grid.RowSpan="3"
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{Binding SoftBackground}"
                                CornerRadius="{StaticResource ProximaRadius.Card}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource ProximaFont.Family}"
                                    FontSize="18"
                                    FontWeight="ExtraBold"
                                    Foreground="{Binding AccentBrushKey}"
                                    Text="{Binding Icon}" />
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    FontFamily="{StaticResource ProximaFont.Family}"
                                    FontSize="12"
                                    FontWeight="ExtraBold"
                                    Foreground="{Binding AccentBrushKey}"
                                    Text="{Binding LevelText}" />
                                <TextBlock
                                    FontFamily="{StaticResource ProximaFont.Family}"
                                    FontSize="12"
                                    Foreground="#8A99AB"
                                    Text="{Binding SourceText}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,4,0,0"
                                FontFamily="{StaticResource ProximaFont.Family}"
                                FontSize="15"
                                FontWeight="ExtraBold"
                                Foreground="#001629"
                                Text="{Binding Title}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,6,0,0"
                                FontFamily="{StaticResource ProximaFont.Family}"
                                FontSize="13"
                                Foreground="#4E5966"
                                LineHeight="18"
                                MaxHeight="72"
                                Text="{Binding Message}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
