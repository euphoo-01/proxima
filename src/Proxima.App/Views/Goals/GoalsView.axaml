<UserControl
    x:Class="Proxima.App.Views.Goals.GoalsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Proxima.App.Controls"
    xmlns:goals="using:Proxima.App.Views.Goals"
    x:DataType="goals:GoalsViewModel"
    mc:Ignorable="d"
    d:DataContext="{x:Static goals:GoalsDesignData.Sample}">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" Background="{StaticResource ProximaBrush.Sidebar}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,24,34,64" RowDefinitions="Auto,24,*">
                <TextBlock Classes="proxima-page-title" Text="{Binding PageTitle}" />

                <Border Grid.Row="2" Classes="proxima-card-surface" IsVisible="{Binding IsLoading}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="proxima-card-title" Text="Загрузка целей..." />
                        <TextBlock Classes="proxima-caption" Text="Подготавливаем долгосрочный прогноз и точки достижения." />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Classes="proxima-card-surface" IsVisible="{Binding HasError}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="proxima-card-title" Text="Ошибка загрузки" />
                        <TextBlock Classes="proxima-caption" Text="{Binding ErrorText}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="2.08*,292" RowDefinitions="470,Auto" ColumnSpacing="24" RowSpacing="14" IsVisible="{Binding HasContent}">
                    <Border Classes="proxima-goals-hero-card">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="proxima-goals-section-title" Text="Предсказание дохода" />
                                    <TextBlock Classes="proxima-goals-section-subtitle" Text="Долгосрочная симуляция, основанная на текущем доходе" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                    <Button Classes="proxima-goals-horizon-button" Classes.active="{Binding IsTwentyFiveYearsSelected}" Command="{Binding SelectHorizonCommand}" CommandParameter="25" Content="25 лет" />
                                    <Button Classes="proxima-goals-horizon-button" Classes.active="{Binding IsFortyYearsSelected}" Command="{Binding SelectHorizonCommand}" CommandParameter="40" Content="40 лет" />
                                    <Button Classes="proxima-goals-horizon-button" Classes.active="{Binding IsFiftyYearsSelected}" Command="{Binding SelectHorizonCommand}" CommandParameter="50" Content="50 лет" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,22,0,0">
                                <controls:GoalForecastChart
                                    EmptyStateText="Добавьте цель, чтобы увидеть прогноз"
                                    ErrorStateText="{Binding ProjectionChartErrorText}"
                                    Height="330"
                                    HorizonYears="{Binding SelectedHorizonYears}"
                                    IsLoading="{Binding IsProjectionChartLoading}"
                                    Milestones="{Binding ForecastMilestones}"
                                    Points="{Binding ForecastPoints}"
                                    StartYear="{Binding CurrentYear}"
                                    VerticalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="22">
                        <Border Classes="proxima-goals-independence-card">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Classes="proxima-goals-eyebrow" Text="До финансовой независимости" />
                                <TextBlock Grid.Row="1" Classes="proxima-goals-metric-value" Text="{Binding FinancialIndependenceYearsText}" />
                                <StackPanel Grid.Row="2" Spacing="7">
                                    <ProgressBar Classes="proxima-goals-progress" Maximum="100" Minimum="0" Value="{Binding FinancialIndependenceProgressPercent}" />
                                    <TextBlock Classes="proxima-goals-small-caption" Text="{Binding FinancialIndependenceProgressText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="proxima-goals-risk-card">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                <TextBlock Classes="proxima-goals-eyebrow" Text="Оценка риска" />
                                <TextBlock Grid.Row="1" Classes="proxima-goals-risk-value" Text="{Binding RiskLevelText}" />
                                <Border Grid.Column="1" Grid.Row="1" Classes="proxima-goals-risk-pill" VerticalAlignment="Center">
                                    <TextBlock Classes="proxima-goals-risk-pill-text" Text="{Binding RiskPillText}" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" Classes="proxima-goal-list-card">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="proxima-goals-section-title" Text="Список целей" />
                                <Button Grid.Column="1" Classes="proxima-goals-add-button" Command="{Binding OpenAddGoalCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="+" />
                                        <TextBlock Text="Добавить" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,22,0,0" Classes="proxima-goals-empty-list" IsVisible="{Binding IsEmpty}">
                                <TextBlock Classes="proxima-caption" Text="Добавьте первую финансовую цель." />
                            </Border>

                            <ItemsControl Grid.Row="1" Margin="0,22,0,0" ItemsSource="{Binding Goals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="goals:GoalListItemViewModel">
                                        <Border Classes="proxima-goal-card" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="74,*,44" ColumnSpacing="16">
                                                <Border Classes="proxima-goal-thumbnail">
                                                    <TextBlock Classes="proxima-goal-thumbnail-text" Text="{Binding ThumbnailText}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Classes="proxima-goal-title" Text="{Binding Name}" />
                                                    <TextBlock Classes="proxima-goal-amount" Text="{Binding TargetText}" />
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Classes="proxima-goal-menu-button"
                                                        Command="{Binding DataContext.OpenEditGoalCommand, RelativeSource={RelativeSource AncestorType=goals:GoalsView}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="•••" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Grid.Row="1" Classes="proxima-contribution-input-card" MinHeight="314">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Spacing="22">
                                <TextBlock Classes="proxima-goals-dark-title" Text="Ежемесячное&#x0a;пополнение" />
                                <TextBlock Classes="proxima-goals-dark-caption" Text="Измените месячный взнос, чтобы моментально увидеть его влияние на рост капитала" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Row="1" Classes="proxima-goals-contribution-field" VerticalAlignment="Bottom">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <TextBlock Classes="proxima-goals-dollar" Text="$" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Classes="proxima-goals-contribution-input"
                                             Text="{Binding MonthlyContribution, Mode=TwoWay}"
                                             Watermark="2500" />
                                    <TextBlock Grid.Column="2" Classes="proxima-goals-check" Text="✓" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="2" Margin="0,12,0,0" Classes="proxima-goals-dark-caption" Text="{Binding ForecastCaption}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <goals:AddGoalDialogView Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding AddGoalDialog}" />
    </Grid>
</UserControl>
