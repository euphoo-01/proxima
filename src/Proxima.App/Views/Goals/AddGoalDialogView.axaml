<UserControl
    x:Class="Proxima.App.Views.Goals.AddGoalDialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:goals="using:Proxima.App.Views.Goals"
    x:DataType="goals:AddGoalDialogViewModel">
    <Border Classes="proxima-modal-overlay" IsVisible="{Binding IsOpen}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="720">
            <Border Classes="proxima-modal-surface">
                <StackPanel Spacing="16">
                    <TextBlock Classes="proxima-card-title" Text="{Binding Title}" />

                    <StackPanel Spacing="8">
                        <TextBlock Classes="proxima-caption" Text="Название цели" />
                        <TextBox Classes="proxima-input" Text="{Binding Name}" Watermark="Например, Финансовая подушка" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="proxima-caption" Text="Целевая сумма" />
                        <TextBox Classes="proxima-input" Text="{Binding TargetAmount}" Watermark="0" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="proxima-caption" Text="Валюта" />
                            <TextBox Classes="proxima-input" Text="{Binding Currency}" Watermark="USD" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Classes="proxima-caption" Text="Взнос в месяц" />
                            <TextBox Classes="proxima-input" Text="{Binding MonthlyContribution}" Watermark="0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="proxima-caption" Text="Ожидаемая доходность %/год" />
                        <TextBox Classes="proxima-input" Text="{Binding ExpectedAnnualReturnPercent}" Watermark="8" />
                    </StackPanel>

                    <TextBlock Classes="proxima-caption" Text="{Binding ValidationMessage}" />

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button Classes="proxima-secondary proxima-toolbar" Command="{Binding CancelCommand}" Content="Отмена" />
                        <Button Classes="proxima-secondary proxima-toolbar" Command="{Binding ArchiveCommand}" Content="Архивировать" IsVisible="{Binding IsEditMode}" />
                        <Button Classes="proxima-primary proxima-toolbar" Command="{Binding SaveCommand}" Content="Сохранить" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
