<UserControl
    x:Class="Proxima.App.Views.Notifications.NotificationsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notifications="using:Proxima.App.Views.Notifications"
    xmlns:vm="using:Proxima.App.ViewModels"
    x:DataType="notifications:NotificationsViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>
        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#667085" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.bento-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E3EAF4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ProximaRadius.Large}" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BoxShadow" Value="0 16 42 0 #10001629" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#4E5966" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8A99AB" />
        </Style>
        <Style Selector="Button.ghost-action">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="{StaticResource ProximaRadius.Small}" />
            <Setter Property="Background" Value="#F3F7FC" />
            <Setter Property="Foreground" Value="#15324F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.danger-action">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="{StaticResource ProximaRadius.Small}" />
            <Setter Property="Background" Value="#FFF0F0" />
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="{StaticResource ProximaBrush.Sidebar}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,24,34,64" Spacing="24">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="8">
                    <TextBlock Classes="page-title" Text="Уведомления" />
                    <TextBlock Classes="page-subtitle" Text="История системных сообщений: ошибки, предупреждения и успешные действия. Уведомление остается здесь до ручного удаления." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                    <Button Classes="ghost-action" Command="{Binding RefreshCommand}" Content="Обновить" />
                    <Button Classes="danger-action" Command="{Binding ClearAllCommand}" Content="Удалить все" />
                </StackPanel>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="bento-card" Margin="0,18,0,0" Padding="20">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Width="48" Height="48" Background="#EEF5FF" CornerRadius="{StaticResource ProximaRadius.Card}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="ExtraBold" Foreground="#2D6CDF" Text="i" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="title" Text="{Binding CountText}" />
                            <TextBlock Classes="body" Text="{Binding StatusMessage}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Classes="bento-card" IsVisible="{Binding IsEmpty}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                    <Border Width="58" Height="58" Background="#EAFBF4" CornerRadius="{StaticResource ProximaRadius.Large}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="ExtraBold" Foreground="#19A974" Text="✓" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="title" Text="Пока нет уведомлений" />
                        <TextBlock Classes="body" Text="Когда в приложении появится ошибка, предупреждение или успешное действие, оно будет показано всплывающим сообщением и сохранено на этой странице." />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppNotificationViewModel">
                        <Border Classes="bento-card">
                            <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="16">
                                <Border Width="42" Height="42" Background="{Binding SoftBackground}" CornerRadius="{StaticResource ProximaRadius.Card}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="ExtraBold" Foreground="{Binding AccentBrushKey}" Text="{Binding Icon}" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock FontFamily="{StaticResource ProximaFont.Family}" FontSize="12" FontWeight="ExtraBold" Foreground="{Binding AccentBrushKey}" Text="{Binding LevelText}" />
                                        <TextBlock Classes="meta" Text="{Binding SourceText}" />
                                        <TextBlock Classes="meta" Text="{Binding CreatedAtText}" />
                                    </StackPanel>
                                    <TextBlock Classes="title" Text="{Binding Title}" />
                                    <TextBlock Classes="body" Text="{Binding Message}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    Classes="danger-action"
                                    Command="{Binding $parent[ItemsControl].DataContext.DeleteCommand}"
                                    CommandParameter="{Binding .}"
                                    Content="Удалить"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
