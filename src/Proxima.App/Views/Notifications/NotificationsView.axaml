<UserControl
    x:Class="Proxima.App.Views.Notifications.NotificationsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notifications="using:Proxima.App.Views.Notifications"
    x:DataType="notifications:NotificationsViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BoxShadow" Value="0 12 36 0 #08001629" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#4E5966" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="#F7F8F9">
        <StackPanel Margin="0,29,34,60" Spacing="24">
            <TextBlock Classes="page-title" Text="Уведомления" />
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="notifications:NotificationItem">
                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="title" Text="{Binding Title}" />
                                <TextBlock Classes="body" Text="{Binding Message}" />
                                <TextBlock Classes="body" Text="{Binding Kind}" Foreground="#8A99AB" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
