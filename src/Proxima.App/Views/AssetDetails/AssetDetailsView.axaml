<UserControl
    x:Class="Proxima.App.Views.AssetDetails.AssetDetailsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Proxima.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:details="using:Proxima.App.Views.AssetDetails"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="details:AssetDetailsViewModel"
    d:DataContext="{x:Static details:AssetDetailsDesignData.Sample}"
    mc:Ignorable="d">

    <ScrollViewer Classes="proxima-asset-details-page" Background="{StaticResource ProximaBrush.Sidebar}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,24,34,64" RowDefinitions="Auto,24,Auto,24,Auto,24,Auto,24,Auto" HorizontalAlignment="Stretch">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" IsVisible="{Binding HasData}">
                <Grid RowDefinitions="Auto,8,Auto" ColumnDefinitions="56,16,*">
                    <Border Grid.RowSpan="3" Classes="asset-logo-box" Width="48" Height="48" VerticalAlignment="Top">
                        <TextBlock Classes="asset-logo-text" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding LogoText}" />
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="asset-headline-title" Text="{Binding AssetName}" />
                        <TextBlock Classes="asset-headline-muted" Text="{Binding AssetTickerMutedText}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <TextBlock Classes="asset-price-primary" Text="{Binding PriceText}" />
                        <TextBlock Classes="asset-delta-text" Classes.positive="{Binding IsDeltaPositive}" VerticalAlignment="Center" Text="{Binding DeltaText}" />
                    </StackPanel>
                </Grid>

                <Button Grid.Column="1" Classes="asset-primary-action" Command="{Binding StartTransactionCommand}" Content="Провести транзакцию" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="0" Classes="asset-card" IsVisible="{Binding IsLoading}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="asset-section-title" Text="Загрузка данных актива..." />
                    <TextBlock Classes="proxima-caption" Text="Подготавливаем график, метрики и транзакции." />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Classes="asset-card" IsVisible="{Binding IsNotFound}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="asset-section-title" Text="Актив не найден" />
                    <TextBlock Classes="proxima-caption" Text="Проверьте переход из списка активов и корректность asset id." />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Classes="asset-card" IsVisible="{Binding HasError}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="asset-section-title" Text="Ошибка загрузки" />
                    <TextBlock Classes="proxima-caption" Text="{Binding ErrorText}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" IsVisible="{Binding HasData}" ColumnDefinitions="2.08*,24,*" MinHeight="468">
                <Border Classes="asset-chart-surface">
                    <Grid RowDefinitions="Auto,18,*">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="asset-section-title" Text="↗ Market Performance" />
                                <TextBlock Classes="proxima-caption" Text="Свечной график. Колесо мыши — масштаб, drag — перемещение." />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                <ItemsControl ItemsSource="{Binding TimeframeOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="details:TimeframeOptionViewModel">
                                            <Button
                                                Classes="asset-timeframe-button"
                                                Classes.active="{Binding IsSelected}"
                                                Command="{Binding DataContext.SelectTimeframeCommand, RelativeSource={RelativeSource AncestorType=details:AssetDetailsView}}"
                                                CommandParameter="{Binding Label}"
                                                Content="{Binding Label}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Classes="asset-chart-inner">
                            <controls:ProximaCandlestickChart
                                Candles="{Binding Candles}"
                                CurrencyCode="{Binding AssetCurrency}"
                                EmptyStateText="Нет свечных данных для выбранного периода"
                                ErrorStateText="{Binding ErrorText}"
                                IsLoading="{Binding IsLoading}"
                                VisibleEndIndex="{Binding CandlesVisibleEndIndex, Mode=TwoWay}"
                                VisibleStartIndex="{Binding CandlesVisibleStartIndex, Mode=TwoWay}" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="2" RowDefinitions="*,24,*">
                    <Border Classes="asset-card-plain">
                        <StackPanel Spacing="20">
                            <TextBlock Classes="asset-kicker" Text="ОЦЕНКА" />
                            <Grid RowDefinitions="Auto,24,Auto,24,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="proxima-caption" Text="Капитализация" />
                                    <TextBlock Grid.Column="1" Classes="asset-value" Text="{Binding MarketCapText}" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="proxima-caption" Text="FDV" />
                                    <TextBlock Grid.Column="1" Classes="asset-value" Text="{Binding FdvText}" />
                                </Grid>
                                <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="proxima-caption" Text="P/E коэф." />
                                    <TextBlock Grid.Column="1" Classes="asset-value" Text="{Binding PeText}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Classes="asset-card-plain">
                        <StackPanel Spacing="20">
                            <TextBlock Classes="asset-kicker" Text="ЛИКВИДНОСТЬ" />
                            <Grid RowDefinitions="Auto,24,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="proxima-caption" Text="Объем 24ч" />
                                    <TextBlock Grid.Column="1" Classes="asset-value" Text="{Binding Volume24hText}" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="proxima-caption" Text="Оборот" />
                                    <TextBlock Grid.Column="1" Classes="asset-value" Text="{Binding SupplyText}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="4" IsVisible="{Binding HasData}" ColumnDefinitions="*,24,*,24,*" MinHeight="208">
                <Border Classes="asset-black-swan-card">
                    <Grid RowDefinitions="Auto,26,Auto,14,Auto">
                        <TextBlock Classes="asset-danger-kicker" Text="ВЛИЯНИЕ ЧЁРНОГО ЛЕБЕДЯ" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Classes="asset-danger-value" Text="{Binding BlackSwanDropText}" />
                            <TextBlock Classes="asset-hint-strong" VerticalAlignment="Center" Text="может упасть" />
                        </StackPanel>
                        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="asset-kicker" Text="VAR" />
                                <TextBlock Classes="asset-value" Text="{Binding VarText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="asset-kicker" Text="CVAR" />
                                <TextBlock Classes="asset-value" Text="{Binding CvarText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="asset-risk-card">
                    <Grid RowDefinitions="Auto,22,Auto,16,Auto" ColumnDefinitions="*,*">
                        <TextBlock Classes="asset-risk-title" Text="РИСК-МЕНЕДЖМЕНТ" />

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                            <TextBlock Classes="asset-risk-kicker" Text="КОЭФ-Т ШАРПА" />
                            <TextBlock Classes="asset-risk-value" Text="{Binding SharpeText}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Spacing="4">
                            <TextBlock Classes="asset-risk-kicker" Text="КОЭФ-Т СОРТИНО" />
                            <TextBlock Classes="asset-risk-value" Text="{Binding SortinoText}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
                            <TextBlock Classes="asset-risk-kicker" Text="КОЭФ-Т КАЛЬМАРА" />
                            <TextBlock Classes="asset-risk-value" Text="{Binding CalmarText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Classes="asset-card">
                    <Grid RowDefinitions="Auto,22,Auto" ColumnDefinitions="*,*,*" ColumnSpacing="16">
                        <TextBlock Grid.ColumnSpan="3" Classes="asset-kicker" Text="КОНТЕКСТНАЯ ОЦЕНКА" />
                        <StackPanel Grid.Row="2" Spacing="5" HorizontalAlignment="Stretch">
                            <TextBlock Classes="asset-context-value" HorizontalAlignment="Center" Text="{Binding HurstText}" />
                            <TextBlock Classes="asset-context-label" Text="ПОК-ЛЬ ХЕРСТА" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5" HorizontalAlignment="Stretch">
                            <TextBlock Classes="asset-context-value" HorizontalAlignment="Center" Text="{Binding ZScoreText}" />
                            <TextBlock Classes="asset-context-label" Text="Z-ОЦЕНКА" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Spacing="5" HorizontalAlignment="Stretch">
                            <TextBlock Classes="asset-context-value" HorizontalAlignment="Center" Text="{Binding CorrelationText}" />
                            <TextBlock Classes="asset-context-label" Text="КОРРЕЛЯЦИЯ" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="6" IsVisible="{Binding HasData}" ColumnDefinitions="*,24,*" MinHeight="250">
                <Border Classes="asset-card-plain">
                    <StackPanel Spacing="20">
                        <TextBlock Classes="asset-kicker" Text="ТЕХНИЧЕСКИЕ ИНДИКАТОРЫ" />
                        <ItemsControl ItemsSource="{Binding TechnicalIndicators}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="details:AssetMetricItemViewModel">
                                    <Border
                                        Classes="asset-metric-tile"
                                        Classes.good="{Binding IsGood}"
                                        Classes.warning="{Binding IsWarning}"
                                        Classes.danger="{Binding IsDanger}"
                                        Width="172"
                                        Margin="0,0,12,12">
                                        <StackPanel Spacing="5">
                                            <TextBlock Classes="asset-kicker" Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Classes="asset-value asset-metric-value" Text="{Binding Value}" TextWrapping="Wrap" />
                                            <TextBlock Classes="asset-hint" Text="{Binding Hint}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="asset-card-plain">
                    <StackPanel Spacing="20">
                        <TextBlock Classes="asset-kicker" Text="ДИНАМИКА РЫНКА" />
                        <ItemsControl ItemsSource="{Binding MarketDynamicsMetrics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="details:AssetMetricItemViewModel">
                                    <Border
                                        Classes="asset-metric-tile"
                                        Classes.good="{Binding IsGood}"
                                        Classes.warning="{Binding IsWarning}"
                                        Classes.danger="{Binding IsDanger}"
                                        Width="154"
                                        Margin="0,0,12,12">
                                        <StackPanel Spacing="5">
                                            <TextBlock Classes="asset-kicker" Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Classes="asset-value asset-metric-value" Text="{Binding Value}" TextWrapping="Wrap" />
                                            <TextBlock Classes="asset-hint" Text="{Binding Hint}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="8" IsVisible="{Binding HasData}" Classes="asset-table-card">
                <Grid RowDefinitions="Auto,26,Auto,8,*">
                    <Grid ColumnDefinitions="*,300,24,Auto">
                        <TextBlock Classes="asset-section-title" Text="История транзакций" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Classes="proxima-input" Text="{Binding SearchQuery}" Watermark="Искать активы..." />
                        <Button Grid.Column="3" Classes="proxima-toolbar" Content="Скачать отчёт" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="1.25*,1.1*,1.2*,1.2*,1.1*,1.1*" Margin="0,0,0,0">
                        <Button Classes="proxima-table-sort-button" Command="{Binding SortByDateCommand}" Content="ДАТА" />
                        <Button Grid.Column="1" Classes="proxima-table-sort-button" Command="{Binding SortByTypeCommand}" Content="ТИП" />
                        <Button Grid.Column="2" Classes="proxima-table-sort-button" Command="{Binding SortByQuantityCommand}" Content="КОЛИЧЕСТВО" />
                        <Button Grid.Column="3" Classes="proxima-table-sort-button" Command="{Binding SortByPriceCommand}" Content="ЦЕНА" />
                        <Button Grid.Column="4" Classes="proxima-table-sort-button" Content="КОМИССИЯ" />
                        <Button Grid.Column="5" Classes="proxima-table-sort-button" Command="{Binding SortByStatusCommand}" Content="СТАТУС" />
                    </Grid>

                    <Border Grid.Row="4" Classes="asset-table-row" IsVisible="{Binding IsTransactionsEmpty}">
                        <TextBlock Classes="proxima-body" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Для этого актива пока нет транзакций." />
                    </Border>

                    <ItemsControl Grid.Row="4" ItemsSource="{Binding VisibleTransactions}" IsVisible="{Binding ShowTransactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="details:AssetTransactionRowViewModel">
                                <Border Classes="asset-table-row">
                                    <Grid ColumnDefinitions="1.25*,1.1*,1.2*,1.2*,1.1*,1.1*">
                                        <TextBlock Classes="proxima-caption" VerticalAlignment="Center" Text="{Binding DateText}" />

                                        <Border
                                            Grid.Column="1"
                                            Classes="asset-transaction-badge"
                                            Classes.buy="{Binding IsBuy}"
                                            Classes.sell="{Binding IsSell}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Classes="asset-transaction-badge-text"
                                                Classes.buy="{Binding IsBuy}"
                                                Classes.sell="{Binding IsSell}"
                                                Text="{Binding TypeLabel}" />
                                        </Border>

                                        <TextBlock Grid.Column="2" Classes="proxima-body" VerticalAlignment="Center" Text="{Binding QuantityText}" />
                                        <TextBlock Grid.Column="3" Classes="proxima-caption" VerticalAlignment="Center" Text="{Binding PriceText}" />
                                        <TextBlock Grid.Column="4" Classes="proxima-caption" VerticalAlignment="Center" Text="{Binding FeeText}" />
                                        <Border Grid.Column="5" Classes="asset-transaction-badge" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="asset-transaction-badge-text" Text="{Binding StatusText}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
