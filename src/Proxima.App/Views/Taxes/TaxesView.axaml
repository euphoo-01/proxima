<UserControl
    x:Class="Proxima.App.Views.Taxes.TaxesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:taxes="using:Proxima.App.Views.Taxes"
    x:DataType="taxes:TaxesViewModel"
    mc:Ignorable="d"
    d:DataContext="{x:Static taxes:TaxesDesignData.Sample}">

    <UserControl.Styles>
        <Style Selector="TextBlock.tax-page-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="LineHeight" Value="42" />
        </Style>

        <Style Selector="TextBlock.tax-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.tax-caption">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#617085" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style Selector="TextBlock.tax-small">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#8A99AB" />
        </Style>

        <Style Selector="TextBlock.tax-value">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="LineHeight" Value="42" />
        </Style>

        <Style Selector="TextBlock.tax-value-medium">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="LineHeight" Value="38" />
        </Style>

        <Style Selector="TextBlock.tax-currency">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="Border.tax-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EDEEF0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #120C2038" />
        </Style>

        <Style Selector="Border.tax-muted-card">
            <Setter Property="Background" Value="#EEF0F2" />
            <Setter Property="BorderBrush" Value="#EEF0F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style Selector="Border.tax-green-card">
            <Setter Property="Background" Value="#A3F69C" />
            <Setter Property="BorderBrush" Value="#A3F69C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style Selector="Border.tax-control-panel">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #0D0C2038" />
        </Style>

        <Style Selector="Border.tax-pill">
            <Setter Property="Background" Value="#E9EEF2" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,5" />
        </Style>

        <Style Selector="Border.tax-alert">
            <Setter Property="Background" Value="#FFF0F0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.tax-info">
            <Setter Property="Background" Value="#EEF7FF" />
            <Setter Property="BorderBrush" Value="#D8EAFB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style Selector="Border.tax-rate-left">
            <Setter Property="Background" Value="#083A5A" />
            <Setter Property="CornerRadius" Value="8,0,0,8" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style Selector="Border.tax-rate-right">
            <Setter Property="Background" Value="#001629" />
            <Setter Property="CornerRadius" Value="0,8,8,0" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style Selector="TextBlock.tax-rate-text">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Border.tax-deadline-item">
            <Setter Property="Background" Value="#F3F4F5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.tax-calendar-badge">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
        </Style>

        <Style Selector="Border.tax-table-header">
            <Setter Property="Background" Value="#F2F4F6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style Selector="Border.tax-table-row">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2F6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style Selector="ProgressBar.tax-progress">
            <Setter Property="Height" Value="12" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="Background" Value="#E9EEF2" />
        </Style>

        <Style Selector="ComboBox.tax-combo">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="156" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,22,32,28" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Classes="tax-page-title" Text="Налоги" />
                    <TextBlock Classes="tax-caption" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Classes="proxima-primary proxima-toolbar"
                    MinWidth="232"
                    Height="44"
                    VerticalAlignment="Center"
                    Command="{Binding ExportPdfCommand}"
                    IsEnabled="{Binding HasContent}">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <TextBlock FontSize="16" Text="⇩" />
                        <TextBlock Text="Экспортировать отчёт" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Classes="tax-control-panel">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <TextBlock Classes="tax-small" Text="ПЕРИОД" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Classes="tax-combo" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" />

                    <TextBlock Grid.Column="2" Classes="tax-small" Text="ПРОФИЛЬ" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <ComboBox Grid.Column="3" Classes="tax-combo" MinWidth="220" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="taxes:TaxProfileOption">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="tax-title" FontSize="13" Text="{Binding Title}" />
                                    <TextBlock Classes="tax-small" FontWeight="Regular" Text="{Binding Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="tax-caption" Text="{Binding SelectedProfile.Description}" />
                        <TextBlock Classes="tax-small" Text="{Binding TransactionCountText}" />
                    </StackPanel>

                    <Button
                        Grid.Column="5"
                        Classes="proxima-secondary proxima-toolbar"
                        Command="{Binding RecalculateCommand}"
                        Content="Рассчитать"
                        MinWidth="132" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="tax-card" IsVisible="{Binding IsLoading}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="tax-title" Text="Расчет выполняется..." />
                    <TextBlock Classes="tax-caption" Text="Подготавливаем налоговый черновик и сверяем источник курсов." />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="tax-card" IsVisible="{Binding HasError}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="tax-title" Text="Ошибка расчета" />
                    <TextBlock Classes="tax-caption" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="tax-card" IsVisible="{Binding IsEmpty}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="tax-title" Text="Нет данных для налогового расчета" />
                    <TextBlock Classes="tax-caption" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" RowSpacing="24" IsVisible="{Binding HasContent}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">
                    <Border Classes="tax-card" MinHeight="180">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="tax-caption" Text="Всего налогов" />
                                <Border Grid.Column="1" Classes="tax-pill">
                                    <TextBlock Classes="tax-small" Foreground="#083A5A" Text="{Binding SummaryStatus}" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="6">
                                <TextBlock Classes="tax-value" Text="{Binding TotalTaxDueText}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="tax-small" Text="ⓘ" />
                                <TextBlock Classes="tax-small" Text="{Binding RateSourceText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="tax-muted-card" MinHeight="180">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Classes="tax-caption" Text="Облагаемая база" />
                            <TextBlock Grid.Row="1" Classes="tax-value-medium" VerticalAlignment="Bottom" Text="{Binding TaxableBaseText}" />
                            <TextBlock Grid.Row="2" Classes="tax-small" Text="После льгот и переносимых убытков" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Classes="tax-green-card" MinHeight="180">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Classes="tax-title" Foreground="#0D4F22" Text="Льготы" />
                            <TextBlock Grid.Row="1" Classes="tax-value-medium" Foreground="#1B6D24" VerticalAlignment="Bottom" Text="{Binding TaxSavedText}" />
                            <TextBlock Grid.Row="2" Classes="tax-caption" Foreground="#1B6D24" Text="Примененные вычеты и необлагаемый лимит" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="24">
                    <StackPanel Spacing="24">
                        <Border Classes="tax-card">
                            <StackPanel Spacing="20">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="tax-title" Text="Двойной налог" />
                                    <TextBlock Grid.Column="1" Classes="tax-caption" Text="W‑8BEN + РБ" />
                                </Grid>

                                <Grid ColumnDefinitions="2*,*">
                                    <Border Classes="tax-rate-left">
                                        <TextBlock Classes="tax-rate-text" Text="{Binding ForeignWithholdingRateText}" />
                                    </Border>
                                    <Border Grid.Column="1" Classes="tax-rate-right">
                                        <TextBlock Classes="tax-rate-text" Text="{Binding LocalTaxRateText}" />
                                    </Border>
                                </Grid>

                                <Border Classes="tax-alert">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <TextBlock FontSize="22" Foreground="#B91C1C" Text="▲" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Classes="tax-title" Foreground="#B91C1C" Text="Форма 1042-S" />
                                            <TextBlock Classes="tax-caption" Foreground="#B91C1C" Text="Запросите форму у брокера до 15 апреля, чтобы подтвердить удержанный налог и снизить риск двойной оплаты." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="tax-card">
                            <StackPanel Spacing="16">
                                <TextBlock Classes="tax-title" Text="Предел дохода" />
                                <TextBlock Classes="tax-caption" Text="Динамический коэффициент налоговой нагрузки после 200 тыс. BYN" TextWrapping="Wrap" />

                                <Grid Margin="10,22,10,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <TextBlock Classes="tax-value-medium" HorizontalAlignment="Center" Text="{Binding IncomeThresholdProgressText}" />
                                    <ProgressBar Grid.Row="1" Classes="tax-progress" Minimum="0" Maximum="100" Value="{Binding IncomeThresholdProgress}" />
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*">
                                        <TextBlock Classes="tax-small" Text="0" />
                                        <Border Grid.Column="1" Background="#E9EEF2" CornerRadius="5" Padding="10,5">
                                            <TextBlock Classes="tax-small" Foreground="#001629" Text="{Binding IncomeThresholdCaption}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Classes="tax-small" HorizontalAlignment="Right" Text="200 тыс." />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" Classes="tax-card">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="tax-title" Text="{Binding DeadlineTitle}" />
                                <TextBlock Grid.Column="1" Classes="tax-caption" Text="контроль" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding DeadlineRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="taxes:TaxDeadlineRowViewModel">
                                        <Border Classes="tax-deadline-item" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                                <Border Classes="tax-calendar-badge">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                                        <TextBlock Classes="tax-small" Foreground="#B91C1C" HorizontalAlignment="Center" Text="{Binding Month}" />
                                                        <TextBlock FontFamily="{StaticResource ProximaFont.Family}" FontSize="22" FontWeight="ExtraBold" Foreground="#001629" HorizontalAlignment="Center" Text="{Binding Day}" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="1" Classes="tax-title" VerticalAlignment="Center" Text="{Binding Title}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="24">
                    <Border Classes="tax-card">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="tax-title" Text="Детализация расчета" />
                                <TextBlock Grid.Column="1" Classes="tax-caption" Text="{Binding CalculationVersion}" />
                            </Grid>

                            <Border Classes="tax-table-header">
                                <Grid ColumnDefinitions="2*,*,2*" ColumnSpacing="12">
                                    <TextBlock Classes="tax-small" Foreground="#64748B" Text="ПОКАЗАТЕЛЬ" />
                                    <TextBlock Grid.Column="1" Classes="tax-small" Foreground="#64748B" Text="ЗНАЧЕНИЕ" />
                                    <TextBlock Grid.Column="2" Classes="tax-small" Foreground="#64748B" Text="КОММЕНТАРИЙ" />
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding BreakdownRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="taxes:TaxBreakdownRowViewModel">
                                        <Border Classes="tax-table-row">
                                            <Grid ColumnDefinitions="2*,*,2*" ColumnSpacing="12">
                                                <TextBlock Classes="tax-caption" Foreground="#001629" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Classes="tax-caption" FontWeight="Bold" Foreground="#001629" Text="{Binding ValueText}" />
                                                <TextBlock Grid.Column="2" Classes="tax-caption" Text="{Binding Note}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="24">
                        <Border Classes="tax-info">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="tax-title" Text="Параметры расчета" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                                    <TextBlock Classes="tax-caption" Text="Профиль" />
                                    <TextBlock Grid.Column="1" Classes="tax-caption" FontWeight="Bold" Foreground="#001629" Text="{Binding SelectedProfileName}" />

                                    <TextBlock Grid.Row="1" Classes="tax-caption" Text="Ставка РБ" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="tax-caption" FontWeight="Bold" Foreground="#001629" Text="{Binding LocalTaxRateText}" />

                                    <TextBlock Grid.Row="2" Classes="tax-caption" Text="Дивиденды" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="tax-caption" FontWeight="Bold" Foreground="#001629" Text="{Binding DividendTaxRateText}" />

                                    <TextBlock Grid.Row="3" Classes="tax-caption" Text="Лимит льгот" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="tax-caption" FontWeight="Bold" Foreground="#001629" Text="{Binding ExemptionAmountText}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="tax-card">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="tax-title" Text="Юридическая оговорка" />
                                <TextBlock Classes="tax-caption" Text="{Binding TaxDisclaimer}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="tax-alert" IsVisible="{Binding IsOfflineRate}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="tax-title" Foreground="#B91C1C" Text="Проверьте курс валют" />
                                <TextBlock Classes="tax-caption" Foreground="#B91C1C" Text="{Binding OfflineRateMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
