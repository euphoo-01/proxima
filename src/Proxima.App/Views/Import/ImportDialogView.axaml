<UserControl
    x:Class="Proxima.App.Views.Import.ImportDialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:import="using:Proxima.App.Views.Import"
    x:DataType="import:ImportDialogViewModel">

    <UserControl.Styles>
        <Style Selector="ScrollViewer.import-scroll">
            <Setter Property="Background" Value="{StaticResource ProximaBrush.Sidebar}" />
        </Style>

        <Style Selector="TextBlock.page-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#5E6B79" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style Selector="Border.card-muted">
            <Setter Property="Background" Value="#F0F2F4" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.section-subtitle">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#6C7886" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style Selector="Button.primary-dark">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#001629" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#001629" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>

        <Style Selector="Button.secondary-action">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#E0E4E8" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="BorderBrush" Value="#E0E4E8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>

        <Style Selector="TextBlock.metric-kicker">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#9AAABD" />
        </Style>

        <Style Selector="TextBlock.metric-value">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.metric-hint">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6C7886" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBox.path-input">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="CaretBrush" Value="#001629" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox.path-input:focus">
            <Setter Property="BorderBrush" Value="#9FC7F5" />
        </Style>

        <Style Selector="Border.drop-surface">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BorderBrush" Value="#DFE5EA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.drop-surface.dragover">
            <Setter Property="BorderBrush" Value="#7BAAF7" />
            <Setter Property="Background" Value="#F5FAFF" />
        </Style>

        <Style Selector="Border.drop-surface.selected">
            <Setter Property="BorderBrush" Value="#84C88A" />
            <Setter Property="Background" Value="#F7FCF7" />
        </Style>

        <Style Selector="Border.drop-surface.parsing">
            <Setter Property="BorderBrush" Value="#E5C067" />
            <Setter Property="Background" Value="#FFF9EC" />
        </Style>

        <Style Selector="Border.drop-surface.error">
            <Setter Property="BorderBrush" Value="#F0A5A0" />
            <Setter Property="Background" Value="#FFF4F4" />
        </Style>

        <Style Selector="Border.status-badge">
            <Setter Property="Background" Value="#EDF1F5" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style Selector="Border.status-badge.highlight">
            <Setter Property="Background" Value="#E8FBE7" />
        </Style>

        <Style Selector="TextBlock.badge-text">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#46515D" />
        </Style>

        <Style Selector="TextBlock.status-text">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6C7886" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Classes="import-scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,24,34,70" RowDefinitions="Auto,24,Auto,24,Auto">
            <Border Classes="card" Padding="32">
                <StackPanel Spacing="8">
                    <TextBlock Classes="page-title" Text="Импорт активов" />
                    <TextBlock Classes="page-subtitle" Text="Загрузите CSV или PDF в стилистике приложения: аккуратная карточка, прозрачный статус и быстрый переход в ручной импорт, если автоматический сценарий не справился." />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="1.45*,24,0.95*">
                <Border Classes="card" Padding="32,30,30,30">
                    <Grid ColumnDefinitions="*,178" RowDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="24">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Загрузите отчёт брокера" />
                                <TextBlock Classes="section-subtitle" Text="Поддерживаются CSV и PDF до 5 MB. После проверки файл можно доработать через ручной импорт без потери общей стилистики и сценария." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="primary-dark" Command="{Binding ParseFileCommand}" Content="{Binding ParseButtonText}" />
                                <Button Classes="secondary-action" Command="{Binding ClearSelectionCommand}" Content="Очистить" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Width="148" Height="148" CornerRadius="74" Background="#E8FBE7" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="76" Height="76" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M20,8 H40 L50,18 V56 H14 V14 A6,6 0 0 1 20,8 Z" Fill="Transparent" Stroke="#197A29" StrokeThickness="4" StrokeJoin="Round" />
                                    <Path Data="M40,8 V20 H50" Fill="Transparent" Stroke="#197A29" StrokeThickness="4" StrokeJoin="Round" />
                                    <Path Data="M22,33 H42 M22,43 H42" Fill="Transparent" Stroke="#197A29" StrokeThickness="4" StrokeLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
                            <Border Classes="status-badge" Classes.highlight="{Binding HasFileSelected}">
                                <TextBlock Classes="badge-text" Text="{Binding SelectedFileTypeBadge}" />
                            </Border>
                            <Border Classes="status-badge">
                                <TextBlock Classes="badge-text" Text="{Binding CurrentStateLabel}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="card-muted" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="section-title" Text="Сводка по импорту" />

                        <StackPanel Spacing="10">
                            <TextBlock Classes="metric-kicker" Text="ВЫБРАННЫЙ ФАЙЛ" />
                            <TextBlock Classes="metric-value" FontSize="20" Text="{Binding SelectedFileName}" />
                            <TextBlock Classes="metric-hint" Text="{Binding StatusMessage}" />
                        </StackPanel>

                        <Border Background="#FFFFFF" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="metric-kicker" Text="ПОДДЕРЖИВАЕМЫЕ ФОРМАТЫ" />
                                <TextBlock Classes="status-text" Text="• CSV — быстрый импорт табличных брокерских выгрузок" />
                                <TextBlock Classes="status-text" Text="• PDF — первичная проверка, затем доработка вручную при необходимости" />
                                <TextBlock Classes="status-text" Text="• Ошибки выводятся без чувствительных данных" />
                            </StackPanel>
                        </Border>

                        <Button Classes="secondary-action" HorizontalAlignment="Left" Command="{Binding OpenManualImportCommand}" Content="Перейти в ручной импорт" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Classes="card-muted" Padding="24">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section-title" Text="Загрузка файла" />
                        <TextBlock Classes="section-subtitle" Text="Если drag-and-drop уже подключён, экран корректно подсветит состояние. Если нет — достаточно вставить путь к файлу и нажать кнопку проверки." />
                    </StackPanel>

                    <Border Classes="drop-surface"
                            Classes.dragover="{Binding IsDragOver}"
                            Classes.selected="{Binding HasFileSelected}"
                            Classes.parsing="{Binding IsParsing}"
                            Classes.error="{Binding ParseFailed}">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="status-text" Text="Перетащите CSV/PDF или вставьте путь к файлу" />
                            <TextBox Classes="path-input" Text="{Binding FilePath, Mode=TwoWay}" Watermark="/home/user/report.csv" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="primary-dark" Command="{Binding ParseFileCommand}" Content="{Binding ParseButtonText}" />
                                <Button Classes="secondary-action" Command="{Binding ClearSelectionCommand}" Content="Очистить" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFF8E7" CornerRadius="12" Padding="16" IsVisible="{Binding HasValidationWarnings}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-title" FontSize="18" Text="Предупреждения валидации" />
                            <ItemsControl ItemsSource="{Binding WarningItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="status-text" Text="{Binding .}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFF4F4" CornerRadius="12" Padding="16" IsVisible="{Binding ParseFailed}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-title" FontSize="18" Text="Не удалось разобрать файл" />
                            <TextBlock Classes="status-text" Text="Переключитесь на ручной импорт: таблица автоматически подставит всё, что удалось извлечь из файла, а остальное можно будет аккуратно исправить вручную." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
