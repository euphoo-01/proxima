<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:auth="using:Proxima.App.Views.Auth"
    x:DataType="auth:RegisterViewModel">
    <Grid Classes="proxima-auth-page">
        <Border Classes="proxima-auth-card">
            <StackPanel Spacing="{StaticResource ProximaGap.24}">
                <StackPanel Spacing="{StaticResource ProximaGap.8}">
                    <TextBlock Classes="proxima-auth-title" Text="Create Local Profile" />
                    <TextBlock Classes="proxima-body" Text="Registration flow is mapped and reserved for the next auth iteration." />
                </StackPanel>

                <Button Classes="proxima-primary" Content="Continue" IsEnabled="False" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
