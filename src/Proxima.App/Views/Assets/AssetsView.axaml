<UserControl
    x:Class="Proxima.App.Views.Assets.AssetsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assets="using:Proxima.App.Views.Assets"
    x:DataType="assets:AssetsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="24">
                <Border Classes="proxima-card-surface">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="proxima-page-title" Text="{Binding PageTitle}" />
                            <TextBlock Classes="proxima-body" Text="{Binding PageDescription}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="proxima-primary proxima-toolbar" Command="{Binding OpenImportDialogCommand}" Content="Импортировать активы" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="proxima-card-surface" IsVisible="{Binding IsLoading}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="proxima-card-title" Text="Загрузка активов..." />
                        <TextBlock Classes="proxima-caption" Text="Подготавливаем список активов текущего портфеля." />
                    </StackPanel>
                </Border>

                <Border Classes="proxima-card-surface" IsVisible="{Binding HasError}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="proxima-card-title" Text="Ошибка загрузки" />
                        <TextBlock Classes="proxima-caption" Text="{Binding ErrorText}" />
                    </StackPanel>
                </Border>

                <Border Classes="proxima-card-surface" IsVisible="{Binding IsEmpty}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="proxima-card-title" Text="Нет активов" />
                        <TextBlock Classes="proxima-caption" Text="Добавьте актив вручную или загрузите операции через импорт." />
                    </StackPanel>
                </Border>

                <Border Classes="proxima-card-surface" IsVisible="{Binding HasContent}">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="proxima-card-title" Text="Список активов" />
                        <ItemsControl ItemsSource="{Binding Assets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="assets:AssetListItemViewModel">
                                    <Border Classes="proxima-datagrid-cell">
                                        <Grid ColumnDefinitions="2*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="proxima-datagrid-cell-text" Text="{Binding DisplayName}" />
                                                <TextBlock Classes="proxima-caption" Text="{Binding TypeLabel}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Classes="proxima-datagrid-cell-text" Text="{Binding QuantityText}" />
                                            <TextBlock Grid.Column="2" Classes="proxima-datagrid-cell-text" Text="{Binding ValueText}" />
                                            <TextBlock Grid.Column="3" Classes="proxima-caption" Text="Детали" VerticalAlignment="Center" />
                                            <Button Grid.Column="4"
                                                    Classes="proxima-secondary proxima-toolbar"
                                                    Command="{Binding DataContext.OpenAssetDetailsCommand, RelativeSource={RelativeSource AncestorType=assets:AssetsView}}"
                                                    CommandParameter="{Binding .}"
                                                    Content="Открыть" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
    </ScrollViewer>
</UserControl>
