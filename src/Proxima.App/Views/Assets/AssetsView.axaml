<UserControl
    x:Class="Proxima.App.Views.Assets.AssetsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assets="using:Proxima.App.Views.Assets"
    xmlns:market="using:Proxima.Core.Application.MarketData"
    x:DataType="assets:AssetsViewModel">

    <UserControl.Styles>
        <Style Selector="ScrollViewer.assets-scroll">
            <Setter Property="Background" Value="{StaticResource ProximaBrush.Sidebar}" />
        </Style>

        <Style Selector="TextBlock.page-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="LineHeight" Value="42" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style Selector="Border.card-muted">
            <Setter Property="Background" Value="#F0F2F4" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style Selector="TextBlock.hero-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="LineHeight" Value="38" />
        </Style>

        <Style Selector="TextBlock.hero-description">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#3E4753" />
            <Setter Property="LineHeight" Value="24" />
        </Style>

        <Style Selector="Button.primary-dark">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#001629" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#001629" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.primary-dark:pointerover">
            <Setter Property="Background" Value="#06243C" />
        </Style>

        <Style Selector="Button.secondary-action">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#E0E4E8" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="BorderBrush" Value="#E0E4E8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.secondary-action:pointerover">
            <Setter Property="Background" Value="#D4DAE0" />
        </Style>

        <Style Selector="TextBlock.block-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="LineHeight" Value="28" />
        </Style>

        <Style Selector="TextBlock.block-description">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#5E6B79" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <Style Selector="TextBlock.field-label">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#9AAABD" />
        </Style>

        <Style Selector="TextBox.manual-input">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="CaretBrush" Value="#001629" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox.manual-input:focus">
            <Setter Property="BorderBrush" Value="#9FC7F5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ComboBox.manual-input">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ComboBox.manual-input:focus">
            <Setter Property="BorderBrush" Value="#9FC7F5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.symbol-suggestions">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE5EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="Button.symbol-suggestion">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.symbol-suggestion:pointerover">
            <Setter Property="Background" Value="#F0F4F8" />
        </Style>

        <Style Selector="Button.manual-type-chip">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#6B7787" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.manual-type-chip:pointerover">
            <Setter Property="Background" Value="#F6F8FA" />
            <Setter Property="BorderBrush" Value="#D6DEE8" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="Button.manual-type-chip.active">
            <Setter Property="Background" Value="#001629" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.form-message">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#0B6F24" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.form-message.error">
            <Setter Property="Foreground" Value="#A40012" />
        </Style>

        <Style Selector="TextBlock.metric-kicker">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#77869A" />
        </Style>

        <Style Selector="TextBlock.metric-value">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.table-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.table-header">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#9AAABD" />
        </Style>

        <Style Selector="TextBox.search-box">
            <Setter Property="Height" Value="36" />
            <Setter Property="Width" Value="256" />
            <Setter Property="Padding" Value="38,0,12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="CaretBrush" Value="#001629" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.icon-filter-button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.asset-row">
            <Setter Property="Height" Value="78" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="Border.asset-icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#EAF0F5" />
        </Style>

        <Style Selector="Border.asset-icon.crypto">
            <Setter Property="Background" Value="#FF9900" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style Selector="Border.asset-icon.etf">
            <Setter Property="Background" Value="#F3F6F8" />
        </Style>

        <Style Selector="Border.asset-icon.stock">
            <Setter Property="Background" Value="#E8F2FF" />
        </Style>

        <Style Selector="Border.asset-icon.cash">
            <Setter Property="Background" Value="#E8F7ED" />
        </Style>

        <Style Selector="Border.asset-icon.bond">
            <Setter Property="Background" Value="#EAF0F5" />
        </Style>

        <Style Selector="TextBlock.asset-icon-text">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.asset-icon-text.crypto">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style Selector="TextBlock.asset-icon-text.etf">
            <Setter Property="Foreground" Value="#FF1233" />
        </Style>

        <Style Selector="TextBlock.asset-name">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.asset-cell">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.asset-cell.positive">
            <Setter Property="Foreground" Value="#177A28" />
        </Style>

        <Style Selector="TextBlock.asset-cell.negative">
            <Setter Property="Foreground" Value="#D71920" />
        </Style>

        <Style Selector="Border.share-track">
            <Setter Property="Width" Value="126" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#DFE5EA" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>

        <Style Selector="Border.share-fill">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#003658" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.more-button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#CDD6E0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.more-button:pointerover">
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="Button.more-assets">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Classes="assets-scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,24,34,70" RowDefinitions="Auto,12,Auto,32,Auto,32,Auto,32,Auto">
            <TextBlock Classes="page-title" Text="{Binding PageTitle}" />

            <TextBlock
                Grid.Row="2"
                Classes="form-message"
                Classes.error="{Binding HasFormError}"
                IsVisible="{Binding HasFormMessage}"
                Text="{Binding FormMessage}"
                TextWrapping="Wrap" />

            <Grid Grid.Row="4" ColumnDefinitions="1.48*,32,1*">
                <Border Classes="card" MinHeight="330" Padding="32,32,30,30">
                    <Grid ColumnDefinitions="*,178" RowDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="28">
                            <TextBlock Classes="hero-title" Text="{Binding ImportTitle}" />
                            <TextBlock Classes="hero-description" Text="{Binding ImportDescription}" />
                        </StackPanel>

                        <Border Grid.Column="1" Width="148" Height="148" CornerRadius="74" Background="#E8FBE7" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="76" Height="76" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M32,8 L8,20 H56 Z" Fill="#197A29" />
                                    <Rectangle Canvas.Left="12" Canvas.Top="24" Width="40" Height="5" Fill="#197A29" />
                                    <Rectangle Canvas.Left="15" Canvas.Top="32" Width="7" Height="20" Fill="#197A29" />
                                    <Rectangle Canvas.Left="28.5" Canvas.Top="32" Width="7" Height="20" Fill="#197A29" />
                                    <Rectangle Canvas.Left="42" Canvas.Top="32" Width="7" Height="20" Fill="#197A29" />
                                    <Rectangle Canvas.Left="10" Canvas.Top="55" Width="44" Height="5" Fill="#197A29" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" Margin="28,8,0,0">
                            <Button Classes="primary-dark" Command="{Binding OpenImportDialogCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Canvas Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Data="M5,2 H12 L16,6 V16 H5 Z M12,2 V7 H16 M8,12 H13 M10.5,9.5 V14.5" Fill="Transparent" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas>
                                    <TextBlock Text="Импорт отчёта" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="secondary-action" Command="{Binding RefreshQuotesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Canvas Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Data="M9,2 L11,6 L15,4 L13,8 L17,10 L13,12 L15,16 L11,14 L9,18 L7,14 L3,16 L5,12 L1,10 L5,8 L3,4 L7,6 Z" Fill="#001629" />
                                    </Canvas>
                                    <TextBlock Text="{Binding RefreshButtonText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="card-muted" MinHeight="330" Padding="30,32,30,30">
                    <StackPanel Spacing="22">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="block-title" Text="{Binding ManualTitle}" />
                            <TextBlock Classes="block-description" Text="{Binding ManualDescription}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="1.15*,1*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="7">
                                <TextBlock Classes="field-label" Text="АКТИВ" />
                                <TextBox Classes="manual-input" Text="{Binding ManualAssetName, Mode=TwoWay}" Watermark="AAPL, Apple, BTC..." />
                                <Border Classes="symbol-suggestions" IsVisible="{Binding HasManualSymbolSuggestions}">
                                    <ItemsControl ItemsSource="{Binding ManualSymbolSuggestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="market:MarketSymbolCandidate">
                                                <Button
                                                    Classes="symbol-suggestion"
                                                    Command="{Binding DataContext.SelectManualSymbolCommand, RelativeSource={RelativeSource AncestorType=assets:AssetsView}}"
                                                    CommandParameter="{Binding .}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock Classes="asset-name" Text="{Binding PrimaryText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Classes="field-label" Text="{Binding SecondaryText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Classes="form-message" Classes.error="True" IsVisible="{Binding HasSymbolSearchMessage}" Text="{Binding SymbolSearchMessage}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Classes="field-label" Text="ТЕГ" />
                                <ComboBox Classes="manual-input" ItemsSource="{Binding ManualTagOptions}" SelectedItem="{Binding ManualTagText, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="7">
                                <TextBlock Classes="field-label" Text="ТИП ОПЕРАЦИИ" />
                                <Grid ColumnDefinitions="*,8,*" Height="40">
                                    <Button
                                        Grid.Column="0"
                                        Classes="manual-type-chip"
                                        Classes.active="{Binding IsManualBuySelected}"
                                        Command="{Binding SelectManualBuyCommand}"
                                        Content="Покупка" />

                                    <Button
                                        Grid.Column="2"
                                        Classes="manual-type-chip"
                                        Classes.active="{Binding IsManualSellSelected}"
                                        Command="{Binding SelectManualSellCommand}"
                                        Content="Продажа" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="7">
                                <TextBlock Classes="field-label" Text="ДАТА" />
                                <TextBox Classes="manual-input" Text="{Binding ManualDateText, Mode=TwoWay}" Watermark="дд.мм.гг" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="7">
                                <TextBlock Classes="field-label" Text="ЦЕНА" />
                                <TextBox Classes="manual-input" Text="{Binding ManualPriceText, Mode=TwoWay}" Watermark="0.00" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="7">
                                <TextBlock Classes="field-label" Text="КОЛИЧЕСТВО" />
                                <TextBox Classes="manual-input" Text="{Binding ManualQuantityText, Mode=TwoWay}" Watermark="1" />
                            </StackPanel>
                        </Grid>

                        <Button Classes="primary-dark" Width="220" HorizontalAlignment="Center" Command="{Binding AddManualTransactionCommand}" Content="{Binding AddButtonText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="6" ColumnDefinitions="*,24,*,24,*">
                <Border Classes="card" MinHeight="88" Padding="24,18">
                    <Grid ColumnDefinitions="54,*" ColumnSpacing="16">
                        <Border Width="46" Height="46" CornerRadius="23" Background="#84DC84">
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M4,16 L9,11 L13,14 L20,6 M16,6 H20 V10" Fill="Transparent" Stroke="#1E7C2A" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Classes="metric-kicker" Text="ПРИРОСТ" />
                            <TextBlock Classes="metric-value" Text="{Binding GrowthMetricValue}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="card" MinHeight="88" Padding="24,18">
                    <Grid ColumnDefinitions="54,*" ColumnSpacing="16">
                        <Border Width="46" Height="46" CornerRadius="23" Background="#B9DFFF">
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M4,11 L12,6 L20,11 M6,12 H18 M7,15 V19 M12,15 V19 M17,15 V19 M5,20 H19" Fill="Transparent" Stroke="#003658" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Classes="metric-kicker" Text="ОБЩАЯ СТОИМОСТЬ" />
                            <TextBlock Classes="metric-value" Text="{Binding TotalValueMetric}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Classes="card" MinHeight="88" Padding="24,18">
                    <Grid ColumnDefinitions="54,*" ColumnSpacing="16">
                        <Border Width="46" Height="46" CornerRadius="23" Background="#FFD9D7">
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M7,4 H17 V20 H7 Z M10,8 H14 M10,12 H14 M10,16 H14" Fill="Transparent" Stroke="#B31119" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Classes="metric-kicker" Text="НАЛОГОВ" />
                            <TextBlock Classes="metric-value" Text="{Binding TaxesMetric}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="8" Classes="card-muted" MinHeight="434" Padding="24,16,24,26">
                <Grid RowDefinitions="Auto,28,Auto,18,*">
                    <Grid ColumnDefinitions="*,Auto,10,Auto,10,Auto">
                        <TextBlock Classes="table-title" Text="Все активы" VerticalAlignment="Center" />

                        <Grid Grid.Column="1" Width="256" Height="36">
                            <TextBox Classes="search-box" Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="Искать активы..." />
                            <Canvas Width="18" Height="18" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Path Data="M8,14 A6,6 0 1,0 8,2 A6,6 0 0,0 8,14 M12.5,12.5 L16,16" Fill="Transparent" Stroke="#9AAABD" StrokeThickness="1.8" StrokeLineCap="Round" />
                            </Canvas>
                        </Grid>

                        <Button
                            Grid.Column="3"
                            Classes="secondary-action"
                            Command="{Binding ExportReportCommand}"
                            Content="{Binding ExportReportButtonText}"
                            IsEnabled="{Binding CanExportReport}" />

                        <Button Grid.Column="5" Classes="icon-filter-button">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Сортировать по названию" Command="{Binding SortByNameCommand}" />
                                    <MenuItem Header="Сортировать по доле" Command="{Binding SortByShareCommand}" />
                                    <MenuItem Header="Сортировать по стоимости" Command="{Binding SortByValueCommand}" />
                                    <MenuItem Header="Сортировать по изменению" Command="{Binding SortByChangeCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <Canvas Width="18" Height="18">
                                <Path Data="M3,5 H15 M6,9 H12 M8,13 H10" Fill="Transparent" Stroke="#001629" StrokeThickness="2" StrokeLineCap="Round" />
                            </Canvas>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="1.58*,1.05*,1.1*,1.1*,1.2*,0.72*,46" Margin="28,0,18,0">
                        <TextBlock Classes="table-header" Text="АКТИВ" />
                        <TextBlock Grid.Column="1" Classes="table-header" Text="ЧАСТЬ&#x0a;ПОРТФЕЛЯ" />
                        <TextBlock Grid.Column="2" Classes="table-header" Text="ТЕКУЩАЯ&#x0a;ЦЕНА" />
                        <TextBlock Grid.Column="3" Classes="table-header" Text="КОЛИЧЕСТВО" />
                        <TextBlock Grid.Column="4" Classes="table-header" Text="ОБЩАЯ&#x0a;СТОИМОСТЬ" />
                        <TextBlock Grid.Column="5" Classes="table-header" Text="24 Ч" />
                    </Grid>

                    <Border Grid.Row="4" Classes="card" IsVisible="{Binding ShowEmptyState}" Padding="24" VerticalAlignment="Top">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="table-title" Text="Активов пока нет" />
                            <TextBlock Classes="block-description" Text="Добавьте первую транзакцию вручную или импортируйте отчёт брокера. После сохранения актив появится в таблице и в дашборде." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Classes="card" IsVisible="{Binding HasError}" Padding="24" VerticalAlignment="Top">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="table-title" Text="Ошибка загрузки" />
                            <TextBlock Classes="block-description" Text="{Binding ErrorText}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl Grid.Row="4" ItemsSource="{Binding VisibleAssets}" IsVisible="{Binding HasContent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="assets:AssetListItemViewModel">
                                <Border Classes="asset-row" Margin="0,0,0,14">
                                    <Grid ColumnDefinitions="1.58*,1.05*,1.1*,1.1*,1.2*,0.72*,46" Margin="28,0,14,0">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Border Classes="asset-icon" Classes.crypto="{Binding IsCrypto}" Classes.etf="{Binding IsEtf}" Classes.stock="{Binding IsStock}" Classes.cash="{Binding IsCash}" Classes.bond="{Binding IsBond}">
                                                <TextBlock Classes="asset-icon-text" Classes.crypto="{Binding IsCrypto}" Classes.etf="{Binding IsEtf}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding IconText}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Classes="asset-name" Text="{Binding Ticker}" />
                                                <TextBlock Classes="field-label" Text="{Binding Name}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                            <Border Classes="share-track">
                                                <Border Classes="share-fill" Width="{Binding ShareBarWidth}" />
                                            </Border>
                                            <TextBlock Classes="asset-cell" FontSize="11" Text="{Binding ShareText}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Classes="asset-cell" VerticalAlignment="Center" Text="{Binding CurrentPriceText}" />
                                        <TextBlock Grid.Column="3" Classes="asset-cell" VerticalAlignment="Center" Text="{Binding QuantityText}" />
                                        <TextBlock Grid.Column="4" Classes="asset-cell" FontWeight="ExtraBold" VerticalAlignment="Center" Text="{Binding ValueText}" />
                                        <TextBlock Grid.Column="5" Classes="asset-cell" Classes.positive="{Binding IsPositive24H}" Classes.negative="{Binding IsNegative24H}" VerticalAlignment="Center" Text="{Binding Change24HText}" />

                                        <Button Grid.Column="6" Classes="more-button" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Подробности" Command="{Binding OpenCommand}" />
                                                    <MenuItem Header="Редактировать" Command="{Binding EditCommand}" />
                                                    <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <TextBlock Text="•••" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="4" Classes="more-assets" Command="{Binding MoreAssetsCommand}" Content="{Binding MoreAssetsButtonText}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
