<UserControl
    x:Class="Proxima.App.Views.Placeholder.PlaceholderView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:placeholder="using:Proxima.App.ViewModels.Placeholder"
    x:DataType="placeholder:PlaceholderViewModel">
    <Border Margin="24" Padding="24" Classes="proxima-card-surface">
        <StackPanel Spacing="8">
            <TextBlock Classes="proxima-page-title" Text="{Binding Title}" />
            <TextBlock Classes="proxima-body" Text="{Binding Description}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
