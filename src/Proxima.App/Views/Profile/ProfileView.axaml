<UserControl
    x:Class="Proxima.App.Views.Profile.ProfileView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:profile="using:Proxima.App.Views.Profile"
    x:DataType="profile:ProfileViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.profile-nickname">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.card-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#6B7A90" />
        </Style>

        <Style Selector="TextBlock.micro-label">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>

        <Style Selector="Border.surface">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="28" />
        </Style>

        <Style Selector="Border.option-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EBEFF4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style Selector="Border.option-card.selected">
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="BorderBrush" Value="#001629" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Border.option-check">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#A7B3C4" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.option-check.selected">
            <Setter Property="BorderBrush" Value="#001629" />
            <Setter Property="Background" Value="#001629" />
        </Style>

        <Style Selector="Button.primary-action">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.primary-action:pointerover">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>

        <Style Selector="Button.dark-action">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#001629" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#001629" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.text-action">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.danger-link">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#E05757" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.option-button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.option-button:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.avatar-button">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="132" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.avatar-button:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.radio-dot-button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBox.profile-input">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#F7F8F9" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox.portfolio-name-input">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#001629" />
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="#F3F6F8">
        <Grid Margin="0,26,34,70" RowDefinitions="Auto,12,Auto,24,Auto,14,Auto,14,Auto,14,Auto,22,Auto">
            <TextBlock Classes="page-title" Text="Аккаунт" />

            <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock
                    Classes="muted"
                    Foreground="#0E7A4B"
                    IsVisible="{Binding HasStatus}"
                    Text="{Binding StatusMessage}" />
                <TextBlock
                    Classes="muted"
                    Foreground="#E05757"
                    IsVisible="{Binding HasError}"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="4" Classes="surface" MinHeight="184">
                <Grid ColumnDefinitions="132,28,420,*,128">
                    <Button Classes="avatar-button" Click="ChangeAvatar_Click" ToolTip.Tip="Сменить аватар">
                        <Grid Width="132" Height="132">
                            <Border Width="132" Height="132" CornerRadius="66" Background="#0E7A4B" ClipToBounds="True">
                                <Grid>
                                    <Image
                                        IsVisible="{Binding HasAvatar}"
                                        Source="{Binding AvatarBitmap}"
                                        Stretch="UniformToFill" />
                                    <TextBlock
                                        IsVisible="{Binding ShowInitialAvatar}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource ProximaFont.Family}"
                                        FontSize="52"
                                        FontWeight="ExtraBold"
                                        Foreground="#FFFFFF"
                                        Text="{Binding Initial}" />
                                </Grid>
                            </Border>

                            <Border
                                Width="30"
                                Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,4,4"
                                Background="#001629"
                                CornerRadius="15">
                                <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path
                                        Data="M4,5 H12 V12 H4 Z M6,5 L7,3 H9 L10,5 M7,8 A1,1 0 1,0 9,8 A1,1 0 0,0 7,8"
                                        Fill="Transparent"
                                        Stroke="#FFFFFF"
                                        StrokeThickness="1.4"
                                        StrokeLineCap="Round"
                                        StrokeJoin="Round" />
                                </Canvas>
                            </Border>
                        </Grid>
                    </Button>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8" Width="420">
                        <TextBlock Classes="profile-nickname" Text="{Binding Login}" />
                        <TextBox Classes="profile-input" Watermark="Имя пользователя" Text="{Binding DisplayName, Mode=TwoWay}" />
                        <TextBox Classes="profile-input" Watermark="Локация" Text="{Binding Location, Mode=TwoWay}" />
                        <TextBlock Classes="muted" Text="{Binding RoleDisplayName}" />
                    </StackPanel>

                    <Button
                        Grid.Column="4"
                        Classes="primary-action"
                        Command="{Binding SaveCommand}"
                        Content="Сохранить"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="6" ColumnDefinitions="380,32,*">
                <Border Classes="surface">
                    <StackPanel Spacing="20">
                        <TextBlock Classes="section-title" Text="Роль пользователя" />

                        <Button Classes="option-button" Command="{Binding SelectPrivateInvestorCommand}">
                            <Grid ColumnDefinitions="20,12,*" Margin="0,0,0,12">
                                <Border Classes="option-check" Classes.selected="{Binding IsPrivateInvestorSelected}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="option-card" Classes.selected="{Binding IsPrivateInvestorSelected}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="card-title" Text="Частный инвестор" />
                                        <TextBlock Classes="muted" Text="Личный учет активов без клиентских портфелей" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="option-button" Command="{Binding SelectFinancialConsultantCommand}">
                            <Grid ColumnDefinitions="20,12,*" Margin="0,0,0,8">
                                <Border Classes="option-check" Classes.selected="{Binding IsFinancialConsultantSelected}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="option-card" Classes.selected="{Binding IsFinancialConsultantSelected}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="card-title" Text="Финансовый консультант" />
                                        <TextBlock Classes="muted" Text="Ведение нескольких клиентских портфелей" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>

                        <TextBlock
                            Classes="muted"
                            Text="У частного инвестора создание портфелей скрыто. Управление портфелями доступно только финансовому консультанту."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="surface">
                    <StackPanel Spacing="20">
                        <TextBlock Classes="section-title" Text="Тип налогоплательщика" />

                        <Button Classes="option-button" Command="{Binding SelectSelfEmployedCommand}">
                            <Grid ColumnDefinitions="20,12,360" Margin="0,0,0,12">
                                <Border Classes="option-check" Classes.selected="{Binding IsSelfEmployedSelected}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="option-card" Classes.selected="{Binding IsSelfEmployedSelected}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="card-title" Text="Самозанятый" />
                                        <TextBlock Classes="muted" Text="Стандартные тарифы налогообложения" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="option-button" Command="{Binding SelectSoleProprietorCommand}">
                            <Grid ColumnDefinitions="20,12,360" Margin="0,0,0,12">
                                <Border Classes="option-check" Classes.selected="{Binding IsSoleProprietorSelected}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="option-card" Classes.selected="{Binding IsSoleProprietorSelected}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="card-title" Text="Индивидуальный предприниматель" />
                                        <TextBlock Classes="muted" Text="Упрощенные тарифы для бизнеса" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="option-button" Command="{Binding SelectCompanyCommand}">
                            <Grid ColumnDefinitions="20,12,360" Margin="0,0,0,8">
                                <Border Classes="option-check" Classes.selected="{Binding IsCompanySelected}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="option-card" Classes.selected="{Binding IsCompanySelected}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="card-title" TextWrapping="Wrap" Text="Общество с ограниченной ответственностью" />
                                        <TextBlock Classes="muted" Text="Корпоративные тарифы для больших объемов выручки" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="8" Classes="surface" IsVisible="{Binding ShowPortfolioManagement}">
                <StackPanel Spacing="20">
                    <Grid ColumnDefinitions="*,Auto,12,Auto">
                        <TextBlock Classes="section-title" Text="Портфели клиентов" />
                        <Button
                            Grid.Column="1"
                            Classes="text-action"
                            Command="{Binding AddPortfolioCommand}"
                            Content="+ Добавить" />
                        <Button
                            Grid.Column="3"
                            Classes="danger-link"
                            Command="{Binding ArchivePortfolioCommand}"
                            Content="Удалить выбранный" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Portfolios}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="profile:ProfilePortfolioItem">
                                <Grid ColumnDefinitions="20,12,520" Margin="0,0,0,12">
                                    <Button
                                        Classes="radio-dot-button"
                                        Command="{Binding DataContext.SelectPortfolioCommand, RelativeSource={RelativeSource AncestorType=profile:ProfileView}}"
                                        CommandParameter="{Binding .}"
                                        VerticalAlignment="Center">
                                        <Border Classes="option-check" Classes.selected="{Binding IsSelected}" />
                                    </Button>

                                    <Border Grid.Column="2" Classes="option-card" Classes.selected="{Binding IsSelected}" Width="520" MinHeight="82">
                                        <Grid ColumnDefinitions="48,16,*,12,Auto" VerticalAlignment="Center">
                                            <Border Width="48" Height="48" CornerRadius="8" Background="#00314F">
                                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path
                                                        Data="M5,15 L10,10 L13,13 L19,7 M15,7 H19 V11"
                                                        Fill="Transparent"
                                                        Stroke="#FFFFFF"
                                                        StrokeThickness="2"
                                                        StrokeLineCap="Round"
                                                        StrokeJoin="Round" />
                                                </Canvas>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                                <TextBox
                                                    Classes="portfolio-name-input"
                                                    Watermark="Название портфеля"
                                                    Text="{Binding Name, Mode=TwoWay}" />
                                                <TextBlock Classes="muted" Text="{Binding Description}" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="4"
                                                Classes="text-action"
                                                Command="{Binding DataContext.SavePortfolioCommand, RelativeSource={RelativeSource AncestorType=profile:ProfileView}}"
                                                CommandParameter="{Binding .}"
                                                Content="Сохранить"
                                                IsVisible="{Binding IsDirty}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="8" Classes="surface" IsVisible="{Binding HidePortfolioManagement}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section-title" Text="Портфели скрыты" />
                    <TextBlock
                        Classes="muted"
                        Text="Для роли «Частный инвестор» создание и управление портфелями недоступны. Переключите роль на «Финансовый консультант», чтобы включить клиентские портфели."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="10" Classes="surface" IsVisible="{Binding IsApiPanelOpen}">
                <Grid ColumnDefinitions="*,20,Auto" RowDefinitions="Auto,14,Auto,10,Auto">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section-title" Text="Finnhub API key" />
                        <TextBlock Classes="muted" Text="Ключ хранится локально в настройках и используется провайдером котировок Finnhub." TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBox
                        Grid.Row="2"
                        Grid.Column="0"
                        Classes="profile-input"
                        PasswordChar="●"
                        Watermark="Вставьте Finnhub API key"
                        Text="{Binding FinnhubApiKey, Mode=TwoWay}" />

                    <Button
                        Grid.Row="2"
                        Grid.Column="2"
                        Classes="dark-action"
                        Command="{Binding SaveFinnhubKeyCommand}"
                        Content="Сохранить ключ" />

                    <TextBlock Grid.Row="4" Classes="muted" Text="{Binding FinnhubKeyStatus}" />
                </Grid>
            </Border>

            <Grid Grid.Row="12" ColumnDefinitions="*,Auto">
                <Button Classes="text-action" Command="{Binding ToggleApiPanelCommand}" Content="API Ключи" HorizontalAlignment="Left" />

                <Button
                    Grid.Column="1"
                    Classes="danger-link"
                    Command="{Binding DeleteAccountCommand}"
                    Content="{Binding DeleteAccountButtonText}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
