<UserControl
    x:Class="Proxima.App.Views.Profile.ProfileView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:profile="using:Proxima.App.Views.Profile"
    x:DataType="profile:ProfileViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="28" />
            <Setter Property="BoxShadow" Value="0 12 36 0 #08001629" />
        </Style>
        <Style Selector="TextBlock.name">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#8A99AB" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#001629" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="#F7F8F9">
        <StackPanel Margin="0,29,34,60" Spacing="24">
            <TextBlock Classes="page-title" Text="Профиль" />
            <Border Classes="card">
                <Grid ColumnDefinitions="86,*" ColumnSpacing="22">
                    <Border Width="86" Height="86" CornerRadius="43" Background="#0E7A4B">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource ProximaFont.Family}" FontSize="34" FontWeight="ExtraBold" Foreground="#FFFFFF" Text="{Binding Initial}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Classes="name" Text="{Binding DisplayName}" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock Classes="label" Text="ЛОГИН" />
                            <TextBlock Grid.Column="1" Classes="value" Text="{Binding Login}" />
                            <TextBlock Grid.Row="1" Classes="label" Text="РОЛЬ" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding RoleDisplayName}" />
                            <TextBlock Grid.Row="2" Classes="label" Text="ID ПРОФИЛЯ" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding UserId}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
