<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <FontFamily x:Key="ProximaFont.Family">Manrope, Segoe UI, Arial</FontFamily>

        <x:Double x:Key="ProximaFontSize.PageTitle">36</x:Double>
        <x:Double x:Key="ProximaFontSize.CardTitle">17</x:Double>
        <x:Double x:Key="ProximaFontSize.Body">15</x:Double>
        <x:Double x:Key="ProximaFontSize.Caption">13</x:Double>
        <x:Double x:Key="ProximaFontSize.MetricValue">34</x:Double>
    </Styles.Resources>

    <Style Selector="TextBlock.proxima-page-title">
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="{StaticResource ProximaFontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource ProximaBrush.TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.proxima-card-title">
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="{StaticResource ProximaFontSize.CardTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource ProximaBrush.TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.proxima-body">
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="{StaticResource ProximaFontSize.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource ProximaBrush.TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.proxima-caption">
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="{StaticResource ProximaFontSize.Caption}" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource ProximaBrush.TextMuted}" />
    </Style>
</Styles>
