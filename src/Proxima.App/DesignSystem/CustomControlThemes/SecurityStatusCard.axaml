<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="Border.proxima-security-status-card">
        <Setter Property="Background" Value="{StaticResource ProximaBrush.AccentBlueSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource ProximaBrush.AccentBlueBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ProximaRadius.Card}" />
        <Setter Property="Padding" Value="{StaticResource ProximaSpace.16}" />
    </Style>
</Styles>
