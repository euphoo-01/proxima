<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:Proxima.App.Controls">
    <Style Selector="controls|MetricCard.proxima-portfolio-value-card">
        <Setter Property="MinHeight" Value="220" />
        <Setter Property="CardPadding" Value="{StaticResource ProximaSpace.32}" />
        <Setter Property="CardBackground" Value="{StaticResource ProximaBrush.GradientBlueHero}" />
        <Setter Property="CardBorderBrush" Value="{StaticResource ProximaBrush.AccentBlueBorder}" />
    </Style>

    <Style Selector="controls|MetricCard.proxima-growth-metric-card">
        <Setter Property="MinHeight" Value="220" />
        <Setter Property="CardBackground" Value="{StaticResource ProximaBrush.GradientMintHero}" />
        <Setter Property="CardBorderBrush" Value="{StaticResource ProximaBrush.AccentMintBorder}" />
    </Style>
</Styles>
