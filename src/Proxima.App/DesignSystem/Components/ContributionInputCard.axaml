<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="Border.proxima-contribution-input-card">
        <Setter Property="Background" Value="#001629" />
        <Setter Property="BorderBrush" Value="#001629" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="30,32,30,30" />
    </Style>

    <Style Selector="TextBlock.proxima-goals-dark-title">
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="TextBlock.proxima-goals-dark-caption">
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="#8EA2B8" />
    </Style>

    <Style Selector="Border.proxima-goals-contribution-field">
        <Setter Property="Background" Value="#173147" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="22,0,20,0" />
        <Setter Property="Height" Value="80" />
    </Style>

    <Style Selector="TextBlock.proxima-goals-dollar">
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="#8EA2B8" />
    </Style>

    <Style Selector="TextBlock.proxima-goals-check">
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="TextBox.proxima-goals-contribution-input">
        <Setter Property="MinHeight" Value="70" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#173147" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="CaretBrush" Value="#FFFFFF" />
        <Setter Property="SelectionBrush" Value="#2A638B" />
        <Setter Property="SelectionForegroundBrush" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="29" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.proxima-goals-contribution-input:pointerover, TextBox.proxima-goals-contribution-input:focus, TextBox.proxima-goals-contribution-input:focus-visible, TextBox.proxima-goals-contribution-input:focus-within">
        <Setter Property="Background" Value="#173147" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="CaretBrush" Value="#FFFFFF" />
        <Setter Property="SelectionBrush" Value="#2A638B" />
        <Setter Property="SelectionForegroundBrush" Value="#FFFFFF" />
    </Style>

    <Style Selector="TextBox.proxima-goals-contribution-input /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#173147" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="TextBox.proxima-goals-contribution-input:pointerover /template/ Border#PART_BorderElement, TextBox.proxima-goals-contribution-input:focus /template/ Border#PART_BorderElement, TextBox.proxima-goals-contribution-input:focus-visible /template/ Border#PART_BorderElement, TextBox.proxima-goals-contribution-input:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#173147" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

</Styles>
