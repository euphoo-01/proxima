<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Proxima.App.CustomControls">

    <!--
        Важно: здесь нельзя назначать ComboBox.Theme через ControlTheme без Template.
        Это ломает стандартный Fluent ComboBox template: control есть в layout,
        но визуально может не отрисовываться или выглядеть пустым.
        Поэтому оставляем стандартный template и переопределяем только обычные свойства.
    -->

    <Style Selector="ComboBox, controls|TimeframeSelector">
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{StaticResource ProximaBrushControlBackground}" />
        <Setter Property="Foreground" Value="{StaticResource ProximaBrushControlForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource ProximaBrushControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ProximaRadius.Small}" />
    </Style>

    <Style Selector="ComboBox:pointerover, controls|TimeframeSelector:pointerover">
        <Setter Property="Background" Value="{StaticResource ProximaBrushControlBackgroundPointerOver}" />
        <Setter Property="BorderBrush" Value="{StaticResource ProximaBrushControlBorderPointerOver}" />
        <Setter Property="Foreground" Value="{StaticResource ProximaBrushControlForeground}" />
    </Style>

    <Style Selector="ComboBox:pressed, controls|TimeframeSelector:pressed">
        <Setter Property="Background" Value="{StaticResource ProximaBrushControlBackgroundPressed}" />
        <Setter Property="BorderBrush" Value="{StaticResource ProximaBrushControlBorderFocused}" />
    </Style>

    <Style Selector="ComboBox:focus-visible, ComboBox:focus-within, controls|TimeframeSelector:focus-visible, controls|TimeframeSelector:focus-within">
        <Setter Property="BorderBrush" Value="{StaticResource ProximaBrushControlBorderFocused}" />
    </Style>

    <Style Selector="ComboBox:disabled, controls|TimeframeSelector:disabled">
        <Setter Property="Background" Value="{StaticResource ProximaBrushControlBackgroundDisabled}" />
        <Setter Property="Foreground" Value="{StaticResource ProximaBrushControlForegroundDisabled}" />
        <Setter Property="BorderBrush" Value="{StaticResource ProximaBrushControlBorder}" />
    </Style>
</Styles>
