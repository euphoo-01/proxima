<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    

    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#001629" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="Foreground" Value="#001629" />
    </Style>

    <Style Selector="MenuItem:pressed">
        <Setter Property="Background" Value="#E2E8F0" />
        <Setter Property="Foreground" Value="#001629" />
    </Style>

    <Style Selector="MenuItem:disabled">
        <Setter Property="Foreground" Value="#94A3B8" />
    </Style>

    <Style Selector="Menu">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#001629" />
    </Style>
</Styles>
