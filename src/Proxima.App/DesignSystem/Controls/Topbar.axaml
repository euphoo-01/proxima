<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="Border.proxima-topbar-root">
        <Setter Property="Background" Value="{StaticResource ProximaBrush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource ProximaBrush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{StaticResource ProximaSpace.24}" />
        <Setter Property="BoxShadow" Value="{StaticResource ProximaShadow.Nav}" />
    </Style>

    <Style Selector="TextBlock.proxima-breadcrumb">
        <Setter Property="Foreground" Value="{StaticResource ProximaBrush.TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</Styles>
