<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:Proxima.App.Controls">
    <Style Selector="ComboBox, controls|TimeframeSelector">
        <Setter Property="FontFamily" Value="{StaticResource ProximaFont.Family}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{StaticResource ProximaBrush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource ProximaBrush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource ProximaBrush.BorderSubtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource ProximaRadius.Small}" />
    </Style>
</Styles>
