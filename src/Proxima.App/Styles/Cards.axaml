<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:Proxima.App.Controls">
    <Style Selector="controls|BentoCard">
        <Setter Property="CardBackground" Value="{StaticResource ProximaBrush.Surface}" />
        <Setter Property="CardBorderBrush" Value="{StaticResource ProximaBrush.BorderSubtle}" />
        <Setter Property="CardBorderThickness" Value="1" />
        <Setter Property="CardPadding" Value="24" />
        <Setter Property="CardCornerRadius" Value="{StaticResource ProximaRadius.Large}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="{TemplateBinding CardPadding}"
                    Background="{TemplateBinding CardBackground}"
                    BorderBrush="{TemplateBinding CardBorderBrush}"
                    BorderThickness="{TemplateBinding CardBorderThickness}"
                    BoxShadow="{StaticResource ProximaShadow.Card}"
                    CornerRadius="{TemplateBinding CardCornerRadius}">
                    <StackPanel Spacing="16">
                        <StackPanel>
                            <TextBlock Classes="proxima-card-title" Text="{TemplateBinding Title}" />
                            <TextBlock Classes="proxima-caption" Text="{TemplateBinding Subtitle}" />
                        </StackPanel>
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|MetricCard">
        <Setter Property="CardBackground" Value="{StaticResource ProximaBrush.Surface}" />
        <Setter Property="CardBorderThickness" Value="0" />
        <Setter Property="CardCornerRadius" Value="{StaticResource ProximaRadius.Card}" />
        <Setter Property="CardPadding" Value="28" />
        <Setter Property="MinHeight" Value="180" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    MinHeight="{TemplateBinding MinHeight}"
                    Padding="{TemplateBinding CardPadding}"
                    Background="{TemplateBinding CardBackground}"
                    BorderBrush="{TemplateBinding CardBorderBrush}"
                    BorderThickness="{TemplateBinding CardBorderThickness}"
                    BoxShadow="{StaticResource ProximaShadow.Card}"
                    CornerRadius="{TemplateBinding CardCornerRadius}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Classes="proxima-body" Text="{TemplateBinding Label}" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock FontFamily="{StaticResource ProximaFont.Family}" FontSize="36" FontWeight="ExtraBold" Foreground="{StaticResource ProximaBrush.TextPrimary}" LineHeight="40" Text="{TemplateBinding Value}" />
                            <TextBlock Classes="proxima-caption" Text="{TemplateBinding Footer}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Classes="proxima-caption" Text="{TemplateBinding Delta}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EmptyState">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="32" Background="{StaticResource ProximaBrush.SurfaceSubtle}" CornerRadius="{StaticResource ProximaRadius.Card}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Classes="proxima-card-title" HorizontalAlignment="Center" Text="{TemplateBinding Title}" />
                        <TextBlock Classes="proxima-body" HorizontalAlignment="Center" Text="{TemplateBinding Message}" TextAlignment="Center" />
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|StatusPill">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="12,4" Background="{StaticResource ProximaBrush.SurfaceSubtle}" CornerRadius="{StaticResource ProximaRadius.Pill}">
                    <TextBlock
                        FontFamily="{StaticResource ProximaFont.Family}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource ProximaBrush.Brand}"
                        LetterSpacing="1.2"
                        LineHeight="16"
                        Text="{TemplateBinding Text}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|StatusPill.success /template/ Border">
        <Setter Property="Background" Value="{StaticResource ProximaBrush.SuccessSurface}" />
    </Style>

    <Style Selector="controls|StatusPill.warning /template/ Border">
        <Setter Property="Background" Value="{StaticResource ProximaBrush.WarningSurface}" />
    </Style>

    <Style Selector="controls|StatusPill.danger /template/ Border">
        <Setter Property="Background" Value="{StaticResource ProximaBrush.DangerSurface}" />
    </Style>

    <Style Selector="controls|PageHeader">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="proxima-page-title" Text="{TemplateBinding Title}" />
                        <TextBlock Classes="proxima-body" Text="{TemplateBinding Subtitle}" />
                    </StackPanel>
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
