<Application
    x:Class="Proxima.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Proxima.App/DesignSystem/Themes/ProximaTheme.axaml" />
    </Application.Styles>
</Application>
